{
  "name": "game-trends",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "test:cron": "node --env-file=.env.local scripts/test-cron.mjs",
    "suggest-links": "node --env-file=.env.local scripts/suggest-links.mjs",
    "links:review": "node --env-file=.env.local scripts/links-review.mjs",
    "links:confirm": "node --env-file=.env.local scripts/links-confirm.mjs",
    "links:probe": "node --env-file=.env.local scripts/links-probe.mjs",
    "links:undo": "node --env-file=.env.local scripts/links-undo.mjs",
    "links:add": "node --env-file=.env.local scripts/links-add.mjs",
    "links:rename": "node --env-file=.env.local scripts/links-rename.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "make:icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@opennextjs/cloudflare": "^1.20.8",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.147.0"
  }
}
