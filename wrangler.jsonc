// 配信トレンドを Cloudflare Workers で動かす設定（OpenNext 経由）。
// 毎時の収集を呼ぶ Worker は別物（cron-worker/wrangler.jsonc）
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stream-trends",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // 公開URLは stream-trends.sukinote.com だけにする。*.workers.dev の既定URLは
  // アカウントのサブドメイン（本名を含む）が出るのと、入口が増えるだけなので作らない
  "workers_dev": false,
  "preview_urls": false,

  // 独自ドメインで公開する。DNS の行は Cloudflare が自動で作る
  // （同じ名前の行が既にあると失敗するので、Vercel 向けの CNAME は削除済み）
  "routes": [{ "pattern": "stream-trends.sukinote.com", "custom_domain": true }],

  // JS・CSS・public の画像などの静的ファイル。ここへのリクエストは無料・無制限
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  // OpenNext がキャッシュの作り直しで自分自身を呼ぶための設定
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "stream-trends",
    },
  ],

  // ページの作り置き（revalidate で作り直すまで全訪問者に共通で返す分）の置き場
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "stream-trends-cache",
    },
  ],

  // DB（Cloudflare D1）。Turso から移した（2026-11）。Turso は読み取りが無料枠を超えて
  // 有料プランにしていたが、D1 は Workers 有料プランの枠（読み取り月250億行）に収まるため。
  // 場所は利用者が日本なので apac。remote: true は、手元の `npm run preview` でも
  // 本番の D1 を使うため（手元に空の DB を作っても確かめられることが少ない）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stream-trends",
      "database_id": "48f47f5d-a34b-4fbe-ab5c-62104bf09e71",
      "remote": true,
    },
  ],

  // 実行ログをダッシュボードで見られるようにする（不具合の調査用）
  "observability": {
    "enabled": true,
  },
}
